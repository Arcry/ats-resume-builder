# Copy this file to .env.local (ignored by git) and fill in the keys for the providers you use.
# Provider and model are chosen in the app ("AI assistant" block); that choice is stored in the browser.
# Dev server: new keys are picked up without a restart; after changing or removing a key, restart `npm run dev`. The production service (npm run app:*) reads .env.local once at start: run `npm run app:restart` after any change.

#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#GROQ_API_KEY=
#DEEPSEEK_API_KEY=
#MISTRAL_API_KEY=

# Optional key for the "Custom" preset (its base URL is entered in the app).
#AI_CUSTOM_API_KEY=

# Ollama and LM Studio need no key.
